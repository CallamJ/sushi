use std.process
use std.string

var user = { hello: "world", n: 1 }
var run = std.process.run("dotnet", ["--version"], allowFailure: true)
var text = "  " + user.hello + "  "

var i = 0
var output = ""
while (i < 25) {
    output = text.trim().upper()
    i = i + 1
}

println(output)
println(run.code)
use std.process.{run}
