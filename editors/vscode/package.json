{
  "name": "sushi-language",
  "displayName": "Sushi",
  "description": "Language support for Sushi shell scripts.",
  "version": "0.1.1",
  "publisher": "callamj",
  "repository": { "type": "git", "url": "https://github.com/CallamJ/sushi.git" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:sushi", "onCommand:sushi.runCurrentBuffer", "onCommand:sushi.checkCurrentBuffer", "onCommand:sushi.previewGenerated", "onCommand:sushi.restartLanguageServer"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [{ "id": "sushi", "aliases": ["Sushi", "sushi"], "extensions": [".sushi"], "configuration": "./language-configuration.json" }],
    "grammars": [{ "language": "sushi", "scopeName": "source.sushi", "path": "./syntaxes/sushi.tmLanguage.json" }],
    "commands": [
      { "command": "sushi.runCurrentBuffer", "title": "Sushi: Run Current Buffer", "icon": "$(play)" },
      { "command": "sushi.checkCurrentBuffer", "title": "Sushi: Check Current Buffer", "icon": "$(check)" },
      { "command": "sushi.previewGenerated", "title": "Sushi: Preview Generated Output", "icon": "$(file-code)" },
      { "command": "sushi.restartLanguageServer", "title": "Sushi: Restart Language Server" }
    ],
    "configuration": {
      "title": "Sushi",
      "properties": {
        "sushi.serverPath": { "type": "string", "default": "sushi", "description": "Path to the Sushi executable." },
        "sushi.targetProfile": { "type": "string", "default": "auto", "description": "Target profile used for Sushi diagnostics." },
        "sushi.trace.server": { "type": "string", "default": "off", "enum": ["off", "messages", "verbose"], "description": "Trace Sushi LSP traffic." }
      }
    }
  },
  "scripts": { "compile": "tsc -p ./", "package": "npm run compile && npx @vscode/vsce package" },
  "dependencies": { "vscode-languageclient": "^9.0.1" },
  "devDependencies": { "@types/node": "^20.0.0", "@types/vscode": "^1.90.0", "typescript": "^5.5.0", "@vscode/vsce": "^3.0.0" }
}
