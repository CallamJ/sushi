// `?` explicitly converts a known value to bool. It does not catch errors.
var token = std.env.get("SUSHI_TOKEN")
var retries = 0
var steps = []

if (?token) {
    println("token configured")
}

if (!?retries) {
    println("no retries yet")
}

// Collections are values when non-null, even when empty.
if (?steps) {
    println("steps collection is available")
}

// Plain conditions are boolean-only.
if (std.env.has("SUSHI_TOKEN")) {
    println("token environment variable exists")
}
