var runResult = std.process.run(
    "git",
    ["--version"],
    allowFailure: true
)
println("git --version:")
println(runResult.stdout)
println("git exit code:")
println(runResult.code)
println("git stderr:")
println(runResult.stderr)

var stages = [
    { command: "git", args: ["status", "--short"] },
    { command: "git", args: ["hash-object", "--stdin"] }
]

var pipelineResult = std.process.pipeline(
    stages,
    allowFailure: true
)
println("pipeline stdout:")
println(pipelineResult.stdout)
println("pipeline exit code:")
println(pipelineResult.code)
println("pipeline stderr:")
println(pipelineResult.stderr)
