var raw = "  Hello,World,Regex42  "
var cleaned = raw.trim().lower()

println("cleaned:")
println(cleaned)

var parts = cleaned.split(",", limit: 2)
println("split:")
println(parts[0])
println(parts[1])

println("contains 'world':")
println(cleaned.contains("world"))

println("startsWith 'hello':")
println(cleaned.startsWith("hello"))

println("endsWith '42':")
println(cleaned.endsWith("42"))

var replaced = cleaned.replace("regex42", "account")
println("replace:")
println(replaced)

println("isMatch digits:")
println(cleaned.isMatch("\\d+"))

var match = cleaned.match("([a-z]+)(\\d+)")
println("match object:")
println(match.ok)
println(match.value)
println(match.index)
