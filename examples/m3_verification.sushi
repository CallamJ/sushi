var failures = 0

println("M3 verification started")

var toolName = "dotnet"
var runArgs = ["--version"]
var pipelineStages = [
    { command: "dotnet", args: ["--version"] },
    { command: "dotnet", args: ["--info"] }
]

var runResult = std.process.run(toolName, runArgs, allowFailure: true)
if (runResult.code != 0) {
    println("dotnet unavailable, trying git fallback")
    toolName = "git"
    runArgs = ["--version"]
    pipelineStages = [
        { command: "git", args: ["--version"] },
        { command: "git", args: ["hash-object", "--stdin"] }
    ]
    runResult = std.process.run(toolName, runArgs, allowFailure: true)
}

if (runResult.code == 0) {
    println("PASS process.run exit code")
} else {
    println("FAIL process.run exit code")
    println(runResult.stderr)
    failures += 1
}

if (runResult.stdout != "") {
    println("PASS process.run stdout")
} else {
    println("FAIL process.run stdout")
    failures += 1
}

var pipelineResult = std.process.pipeline(
    pipelineStages,
    allowFailure: true
)

if (pipelineResult.code == 0) {
    println("PASS process.pipeline exit code")
} else {
    println("FAIL process.pipeline exit code")
    println(pipelineResult.stderr)
    failures += 1
}

if (pipelineResult.stdout != "") {
    println("PASS process.pipeline stdout")
} else {
    println("FAIL process.pipeline stdout")
    failures += 1
}

var payload = { tool: "sushi", count: 3, ok: true }
var jsonText = std.json.stringify(payload)
var parsed = std.json.parse(jsonText)

if (parsed.tool == "sushi") {
    println("PASS json.parse field")
} else {
    println("FAIL json.parse field")
    failures += 1
}

if (parsed.count == 3) {
    println("PASS json.parse numeric field")
} else {
    println("FAIL json.parse numeric field")
    failures += 1
}

if (parsed.ok == true) {
    println("PASS json.parse bool field")
} else {
    println("FAIL json.parse bool field")
    failures += 1
}

var verifyPath = std.path.join("tmp", "m3_verify.txt")
std.io.writeText(verifyPath, "ok")
var globMatches = std.fs.glob("tmp/m3_verify*.txt")
var firstMatch = globMatches[0]

if (firstMatch != null) {
    println("PASS fs.glob")
} else {
    println("FAIL fs.glob")
    failures += 1
}

var skipHttp = std.env.get("SUSHI_SKIP_HTTP", "0")
if (skipHttp == "1") {
    println("SKIP http (SUSHI_SKIP_HTTP=1)")
} else {
    var response = std.http.get("https://example.com")
    if (response.status == 0) {
        println("SKIP http (unavailable in current runtime/network)")
    } else {
        if (response.ok == true) {
            println("PASS http.get ok")
        } else {
            println("FAIL http.get ok")
            println(response.status)
            failures += 1
        }

        if (response.body != "") {
            println("PASS http.get body")
        } else {
            println("FAIL http.get body")
            failures += 1
        }
    }
}

if (failures == 0) {
    println("M3 verification PASSED")
    std.process.exit(0)
} else {
    println("M3 verification FAILED")
    println(failures)
    std.process.exit(1)
}
