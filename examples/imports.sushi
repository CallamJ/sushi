// === helpers.sushi ===
box = Sushi.Helpers

greet(person: Person) {
    print("Hello, " + person.name)
}

class Person {
    let name: string

    new(name: string): Person {
        this.name = name
    }
}




// === app1.sushi === — merge entire box into scope
box = Sushi.App1

// Merge all public symbols from Sushi.Helpers into this box
box += use(Sushi.Helpers)

greet("John")

let p = Person::new("Alice")




// === app2.sushi ===
box = Sushi.App2

// Fetch the Helpers box as a value
let helpers = use(Sushi.Helpers)

// No symbols were injected
greet("John")          // error: greet is undefined

helpers.greet("John")  // works

let p = helpers.Person::new("Alice")




// === app3.sushi === — selective symbol injection
box = Sushi.App3

// Inject only the greet function
box += use(Sushi.Helpers.greet)

greet("World")

Person::new("Bob") // error: Person is not defined




// === app4.sushi === — mixed style
box = Sushi.App4

let Helpers = use(Sushi.Helpers)

// Inject a single symbol
box += use(Helpers.greet)

// Use the rest via the namespace
let p = Helpers.Person::new("Charlie")

greet(p)
