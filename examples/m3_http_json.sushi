var response = std.http.get("https://api.github.com")
println("status:")
println(response.status)

if (response.ok) {
    println("headers:")
    println(std.json.stringify(response.headers, indent: 2))

    if (response.json != null) {
        println("json body preview:")
        println(std.json.stringify(response.json, indent: 2))
    } else {
        println("raw body preview:")
        println(response.body)
    }
}
