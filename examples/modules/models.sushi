box Examples.Models

export class Task {
    string title
    bool done = false

    new(string title) {
        this.title = title
    }

    complete() {
        this.done = true
    }

    string() -> this.title
}

export enum Level(int rank) {
    Low(1),
    Normal(2),
    High(3)
}

export Task createTask(string title) {
    return new Task(title)
}
